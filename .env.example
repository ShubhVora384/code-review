# ─────────────────────────────────────────────────────────────
# Groq  (free keys at https://console.groq.com/keys)
# ─────────────────────────────────────────────────────────────
# Free-tier limits are enforced PER KEY, so up to three keys are rotated:
# three keys = 3x the requests, tokens and daily budget. One key is enough
# to run the system; the extras only raise the ceiling.
GROQ_API_KEY=gsk_replace_me
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Alternative to the numbered vars — comma-separated. Duplicates are dropped.
# GROQ_API_KEYS=gsk_one,gsk_two,gsk_three

# How the next key is chosen: round_robin | random | least_used
GROQ_KEY_STRATEGY=round_robin
# Seconds a 429'd key sits out when Groq sends no Retry-After header.
# Grows with consecutive failures on the same key.
GROQ_KEY_COOLDOWN_SEC=20

# Deep-reasoning model: 131,072 ctx / 65,536 max completion.
GROQ_MODEL_DEEP=openai/gpt-oss-120b
# Reasoning models bill their reasoning trace as completion tokens, which
# is the dominant cost on a per-minute cap. low | medium | high
GROQ_REASONING_EFFORT=low

# Fast triage model, used for small low-risk files.
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Free-tier governor — these are PER KEY, not pool-wide.
GROQ_DEEP_TPM=8000
GROQ_DEEP_RPM=30
GROQ_DEEP_RPD=1000
GROQ_DEEP_TPD=200000
GROQ_FAST_TPM=15000
GROQ_FAST_RPM=30

# ─────────────────────────────────────────────────────────────
# Proof engine
# ─────────────────────────────────────────────────────────────
# Findings are demonstrated rather than asserted: a deterministic trace, or a
# generated experiment executed in a sandbox. A finding the proof DISPROVES is
# dropped from the report entirely.
PROOF_ENABLED=true

# auto | docker | subprocess | disabled
#   docker      the only backend safe for anything hosted
#   subprocess  rlimits + timeout only. Does NOT contain hostile code, and is
#               refused unless APP_ENV=development
#   auto        docker when reachable, else subprocess in development only
PROOF_SANDBOX=auto
PROOF_MAX_PER_REVIEW=10
PROOF_TIMEOUT_SEC=25
PROOF_MEMORY_MB=512
PROOF_IMAGE=python:3.12-slim

# ─────────────────────────────────────────────────────────────
# Local folder picker
# ─────────────────────────────────────────────────────────────
# Directories the "Browse…" picker may list, comma-separated.
# Defaults to your home directory. Narrow it if the API is ever
# reachable beyond localhost — this exposes directory structure.
# BROWSE_ROOTS=/home/you/projects,/mnt/c/work

# ─────────────────────────────────────────────────────────────
# Datastores
# ─────────────────────────────────────────────────────────────
# Docker Compose default:
DATABASE_URL=postgresql+asyncpg://codereview:codereview@localhost:5432/codereview
REDIS_URL=redis://localhost:6379/0

# No Docker? Comment the two above and uncomment these — the app
# falls back to SQLite + an in-process rate limiter automatically.
# DATABASE_URL=sqlite+aiosqlite:///./codereview.db
# REDIS_URL=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKSPACE_DIR=./.workspaces

# Ingestion guardrails
MAX_REPO_MB=200
MAX_FILES=4000
MAX_FILE_KB=512
CLONE_TIMEOUT_SEC=180
